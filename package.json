    "@types/ws": "^8.18.1",
    "async-file": "^2.0.2",
    "body-parser": "^1.19.0",
    "btoa": "^1.2.1",
    "cheerio": "^1.2.0",
    "clapp": "^1.3.3",
    "cli-table3": "^0.6.5",
    "discord.js": "^14.6.0",
    "express": "^4.17.1",
    "jsonfile": "^6.2.0",
    "longjohn": "^0.2.12",
    "mkdirp": "^3.0.1",
    "moment": "^2.27.0",
    "node-fetch": "^2.7.0",
    "node-schedule": "^2.1.1",
    "underscore": "^1.13.1",
    "winston": "^2.4.5"
  },
  "pnpm": {
    "overrides": {
      "minimist-string>minimist": "^1.2.8"
    }
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
