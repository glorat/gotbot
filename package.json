  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "eslint": "^5.16.0",
    "eslint-config-xo-space": "^0.21.0",
    "expect.js": "^0.3.1",
    "mocha": "^10.2.0",
    "nyc": "^17.1.0",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.1",
    "tslint": "^5.20.1",
    "typescript": "^5.9.3"
  },
  "eslintConfig": {
    "extends": "xo-space",
    "env": {
      "mocha": true
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "@types/express": "^4.17.2",
    "@types/nedb": "^1.8.12",
    "@types/node-fetch": "^2.5.4",
