{
  "name": "gotbot",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "description": "",
  "homepage": "https://github.com/glorat/gotbot",
  "author": {
    "name": "Kevin Tam",
    "email": "glorat+github@gmail.com",
    "url": "https://github.com/glorat/gotbot"
  },
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "keywords": [
    ""
